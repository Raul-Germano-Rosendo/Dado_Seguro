# Copie para .env (não versionar). Não coloque segredos aqui: tudo em VITE_* vai para o navegador.
# true = usa dados fictícios, sem backend (apenas para desenvolvimento)
VITE_USE_MOCK=true
# Base da API. Em produção prefira caminho relativo (/api) atrás do Nginx, com HTTPS.
VITE_API_URL=/api
# Destino do proxy de desenvolvimento (ex.: IP privado do backend, acessado via VPN)
VITE_DEV_PROXY=
# Endereço do servidor SFTP mostrado no painel; configure no build de produção.
VITE_SFTP_HOST=sftp.exemplo.invalid
