# Habilite como um novo site no Nginx da instância Backend 1.
# O nome interno seleciona este bloco apenas para chamadas do frontend Nginx.
server {
    listen 80;
    server_name api.dadoseguro.internal;
    client_max_body_size 26m;

    location /api/ {
        proxy_pass http://127.0.0.1:3000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Preserve https from the public frontend proxy; TLS terminates there.
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    }

    location / {
        return 404;
    }
}
